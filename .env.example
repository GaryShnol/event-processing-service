# Copy to .env to override. docker compose sets SERVER_PORT, MONGODB_URI and the AWS
# settings itself, so .env only changes the remaining values there.

SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/events

# AWS. The app has no defaults for these: in AWS the SDK's default chain uses the task
# IAM role and the region's SQS endpoint. To run the app on the host against ElasticMQ,
# set these four (ElasticMQ accepts any credentials).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_SQS=http://localhost:9324

# Queues
EVENTS_QUEUE=events-queue
EVENTS_DLQ=events-dlq

# Processing. Keep the lease below the queue's 90 s visibility timeout and
# max attempts below its maxReceiveCount of 5 (see elasticmq.conf).
PROCESSING_LEASE=60s
PROCESSING_MAX_ATTEMPTS=3
MAX_AMOUNT=10000.00

# Recovery sweeper
SWEEPER_INTERVAL=30s
SWEEPER_REPUBLISH_AFTER=2m
SWEEPER_BATCH_SIZE=100

# Paging
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100

# Logging: ecs, logstash or gelf
LOG_FORMAT=ecs
