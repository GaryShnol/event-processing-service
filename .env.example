# Copy to .env to override. docker compose sets SERVER_PORT, MONGODB_URI and the AWS
# settings itself, so .env only changes the remaining values there.

SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/events

# AWS. The app has no defaults for these: in AWS the SDK's default chain uses the task
# IAM role and the region's SQS endpoint. To run the app on the host against ElasticMQ,
# set these four (ElasticMQ accepts any credentials).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_SQS=http://localhost:9324

# Queues
EVENTS_QUEUE=events-queue
# How long a publish may take before the request gives up on it and returns 202 anyway.
PUBLISH_TIMEOUT=3s
# false for an API-only instance that publishes events but doesn't process them.
SQS_LISTENER_ENABLED=true

# Processing. The app refuses to start unless the lease is shorter than the queue's
# visibility timeout and max attempts is lower than its maxReceiveCount.
PROCESSING_LEASE=60s
PROCESSING_MAX_ATTEMPTS=3
MAX_AMOUNT=10000.00

# Recovery sweeper. false turns it off on this instance.
SWEEPER_ENABLED=true
SWEEPER_INTERVAL=30s
SWEEPER_REPUBLISH_AFTER=2m
SWEEPER_BATCH_SIZE=100

# Paging
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100
# Largest page * size; a deeper page returns 400, so narrow the query with from and to.
PAGE_MAX_OFFSET=10000

# Request metadata bounds
METADATA_MAX_ENTRIES=20
METADATA_MAX_KEY_LENGTH=64
METADATA_MAX_VALUE_LENGTH=256

# MongoDB timeouts, applied in code whatever MONGODB_URI says: the wait for an unreachable MongoDB, and
# for any single operation (one that accepts the connection but stops answering). Both end in a 503.
MONGO_SERVER_SELECTION_TIMEOUT=5s
MONGO_OPERATION_TIMEOUT=10s

# Logging: ecs, logstash or gelf
LOG_FORMAT=ecs
