# Copy to .env to override. Every value below is the default used when the variable is unset.
# docker compose sets MONGODB_URI and SQS_ENDPOINT to the container hostnames itself.

SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/events

# SQS (ElasticMQ locally). ElasticMQ accepts any credentials.
SQS_ENDPOINT=http://localhost:9324
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
EVENTS_QUEUE=events-queue
EVENTS_DLQ=events-dlq

# Processing
PROCESSING_LEASE=60s
PROCESSING_MAX_ATTEMPTS=3
MAX_AMOUNT=10000.00

# Recovery sweeper
SWEEPER_INTERVAL=30s
SWEEPER_REPUBLISH_AFTER=2m
SWEEPER_BATCH_SIZE=100

# Paging
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100

# Logging: ecs, logstash or gelf
LOG_FORMAT=ecs
